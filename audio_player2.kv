#:kivy 2.3.0

<RootWidget@BoxLayout>:
    orientation: "vertical"
    padding: dp(10)
    spacing: dp(10)
    canvas.before:
        Color:
            rgba: 0.15, 0.15, 0.18, 1
        Rectangle:
            pos: self.pos
            size: self.size

    Label:
        id: current_track
        text: app.player.current_track_text
        color: 1, 1, 1, 1
        size_hint_y: None
        height: dp(40)
        font_size: sp(18)

    VisualizerCanvas:
        id: visualizer
        size_hint_y: 0.3

    BoxLayout:
        size_hint_y: None
        height: dp(40)
        spacing: dp(10)

        Label:
            id: elapsed
            text: "00:00"
            size_hint_x: None
            width: dp(60)
            color: 0.8, 0.8, 0.8, 1

        Slider:
            id: progress_slider
            min: 0
            max: app.player.duration if app.player.duration else 1
            value: app.player.position
            on_touch_up:
                if self.collide_point(*args[1].pos): app.player.seek(self.value)

        Label:
            id: total
            text: "03:00"
            size_hint_x: None
            width: dp(60)
            color: 0.8, 0.8, 0.8, 1

    BoxLayout:
        size_hint_y: None
        height: dp(50)
        spacing: dp(10)

        Button:
            text: "⏮ Prev"
            on_release: app.prev()
        Button:
            text: "⏯ Play/Pause"
            on_release: app.toggle_play()
        Button:
            text: "⏭ Next"
            on_release: app.next()
        Button:
            text: "⏹ Stop"
            on_release: app.stop()
